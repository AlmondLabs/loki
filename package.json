{
  "name": "loki",
  "version": "2026.10.11",
  "private": true,
  "license": "Apache-2.0",
  "repository": "github:AlmondLabs/loki",
  "type": "module",
  "description": "A memory palace your agent builds — a desktop app running its own agent daemon on Pi, with a live widget canvas the agent writes files into",
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/dev.ts",
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/dev.ts --hot",
    "dev:vite": "vite --config app/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:node": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test-node/*.node-test.ts",
    "build:app": "vite build --config app/vite.config.ts",
    "build:mod": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-mod.ts",
    "smoke": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/smoke.ts",
    "tauri": "tauri",
    "desktop:dev": "tauri dev --config \"{\\\"build\\\":{\\\"devUrl\\\":\\\"http://127.0.0.1:5173\\\"}}\"",
    "desktop:build": "tauri build",
    "doctor": "react-doctor",
    "analytics": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/analytics.ts",
    "listen": "native/listen/listen.sh",
    "release": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/release.ts",
    "cask": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/cask.ts",
    "shrink-images": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/shrink-images.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@modelcontextprotocol/client": "2.2.0",
    "@napi-rs/keyring": "2.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-zoom-pan-pinch": "^4.1.1",
    "recharts": "^3.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "2.0.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "65.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "3.9.9",
    "react-doctor": "^0.9.13",
    "react-scan": "^0.5.7",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0",
    "vitest": "4.1.11",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.19"
  }
}
