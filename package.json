{
  "name": "loki",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "mobile"
  ],
  "description": "A memory palace your agent builds \u2014 Letta Code mod + Vite widget desk the agent writes files into",
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "build:app": "vite build --config app/vite.config.ts",
    "build:mod": "node scripts/build-mod.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev --config '{\"build\":{\"devUrl\":\"http://127.0.0.1:5173\"}}'",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-zoom-pan-pinch": "^4.1.1",
    "recharts": "^3.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.8.0"
  }
}
