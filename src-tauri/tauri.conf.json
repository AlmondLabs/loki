{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "loki",
  "version": "0.3.0",
  "identifier": "dev.deepak.loki",
  "build": {
    "frontendDist": "../app/dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": "bun run build:app"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
